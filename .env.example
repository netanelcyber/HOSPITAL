# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dss

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage Configuration
STORAGE_TYPE=s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dss-storage
S3_REGION=us-east-1

# Storage Replication
STORAGE_NODES=node1,node2,node3
REPLICATION_STRATEGY=full

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=24h

# UNIX Notifications
NOTIFICATION_SOCKET=/tmp/dss-notification.sock
NOTIFICATION_QUEUE=/tmp/dss-notification-queue
ENABLE_SIGNAL_NOTIFICATIONS=true
ENABLE_SOCKET_NOTIFICATIONS=true
ENABLE_QUEUE_NOTIFICATIONS=true

# PACS Configuration
PACS_ENABLED=true
DICOM_PORT=11112
DICOM_AET=DSS_NODE

# FHIR Configuration (Optional)
FHIR_ENABLED=false
FHIR_VERSION=R4
FHIR_BASE_URL=http://localhost:3000/fhir

# VM Orchestration
VM_HYPERVISOR=virtualbox

# Active Directory Configuration (Optional)
AD_ENABLED=false
AD_SERVER_URL=ldap://ad.example.com:389
AD_BASE_DN=dc=example,dc=com
AD_BIND_DN=cn=admin,dc=example,dc=com
AD_BIND_PASSWORD=password
AD_USER_SEARCH_BASE=ou=users,dc=example,dc=com
AD_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com
AD_TLS_ENABLED=false
AD_TLS_CERT_PATH=/etc/ssl/certs/ca-bundle.crt
AD_SYNC_INTERVAL=3600000
AD_ALLOW_LOCAL_FALLBACK=true

# DNS Configuration
DOMAIN=api.penux.uk
DOMAIN_SSL=true
DOMAIN_PORT=443
ALLOWED_ORIGINS=https://api.penux.uk,https://www.penux.uk,https://penux.uk
SSL_CERT_PATH=/etc/ssl/certs/penux.uk.crt
SSL_KEY_PATH=/etc/ssl/private/penux.uk.key
