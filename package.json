{
  "name": "distributed-sharepoint-system",
  "version": "1.0.0",
  "description": "Distributed cloud-based SharePoint-like system with UNIX notifications",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "setup": "npm install && npm run build",
    "test": "jest",
    "lint": "eslint src/",
    "migrate": "node dist/db/migrations.js"
  },
  "keywords": ["sharepoint", "distributed", "collaboration", "storage"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "postgresql": "^0.0.1",
    "pg": "^8.8.0",
    "redis": "^4.6.0",
    "aws-sdk": "^2.1300.0",
    "dotenv": "^16.0.3",
    "uuid": "^9.0.0",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "socket.io": "^4.5.4",
    "pino": "^8.11.0",
    "node-watch": "^0.7.3",
    "node-gyp": "^9.3.1",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "@types/node": "^18.11.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "eslint": "^8.40.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0"
  }
}
